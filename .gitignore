# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Build output
build/
dist/
release/
*.spec

# Runtime data — never commit these
# (config holds an encrypted password; logs hold traffic and timestamps)
/data/
*.log
config.json
stats.json
status.json
key.bin

# Vendored Flet desktop runtime (38 MB) — fetched by `python build.py --fetch-runtime`
vendor/

# Local scratch
.readme-backup/
_readme*.md

# Dart / Flutter
.dart_tool/
pubspec_overrides.yaml

# 本地备份与一次性脚本（不进仓库）
*.bak-*
tools/swap-readme-*.py

# 原生核心的构建产物（源码在 native/，二进制不入库）
native/obj/
native/bin/
native/*.obj
native/drcomd.exe
native/tests/*.exe
native/tests/*.obj
native/.vs/
.vs/
native/*.vcxproj.user
